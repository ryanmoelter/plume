#!/usr/bin/env bash
# Runs this worktree's debug build, or its UI tests, inside one of Plume's macOS VMs.
# docs/vm-testing.md is the reference.
# Usage: plume-vm <command> [args]
#   claim [--worktree=PATH]   lease a VM (the worktree defaults to this one); prints vm:<n>
#   release [vm:<n>]          release your VM, or that one, and drop its tunnel
#   list                      list the VM slots
#   reset vm:<n>              delete a free slot's clone
#   ssh [-- cmd...]           a shell, or one command, in your VM
#   prepare                   mirror the host's worktree and share paths in the guest
#   launch [--app PATH] [--seed N] [--env K=V]...
#                             copy the debug app into the guest, start it, and forward its control socket
#   test [--only-testing X]... [--skip-build]
#                             build for testing on the host, then run the UI tests in the guest
#                             (needs a base built with make-base-image.sh --with-xcode)
#   grant-fda [--app PATH]    walk through granting the debug app Full Disk Access in a VM, then
#                             save that VM as the base image (once per base image)
# `plume` comes from $PLUME_CLI, else this worktree's build, else PATH, skipping any too old for
# VMs. Set PLUME_SOCKET to the socket of the app that should own the VM.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=lib.sh
source "$ROOT/scripts/vm/lib.sh"

DERIVED_DATA="$ROOT/build/vm-dd"
DEFAULT_TESTS=(PlumeUITests PlumeTests/SurfaceCommandTests PlumeTests/TerminalShortcutReclaimTests PlumeTests/ControlHierarchyTests)
CONTROL="$ROOT/scripts/debug/plume-control.py"

usage() { sed -n '2,19p' "${BASH_SOURCE[0]}"; }
die() { echo "plume-vm: $*" >&2; exit 1; }
log() { echo "==> $*" >&2; }
q() { printf '%q' "$1"; }

products_dir() {
  local cache="$ROOT/build/vm-products-dir" dir=""
  [[ -f "$cache" ]] && dir="$(<"$cache")"
  if [[ -z "$dir" || ! -d "$dir" ]]; then
    dir="$(cd "$ROOT" && xcodebuild -scheme Plume -destination 'platform=macOS' -showBuildSettings 2>/dev/null \
      | awk '/ BUILT_PRODUCTS_DIR = /{ sub(/^[^=]*= /, ""); print; exit }')"
    [[ -n "$dir" ]] || die "xcodebuild -showBuildSettings gave no BUILT_PRODUCTS_DIR"
    mkdir -p "$ROOT/build"
    printf '%s\n' "$dir" > "$cache"
  fi
  printf '%s\n' "$dir"
}

supports_vms() { [[ -x "$1" ]] && "$1" devices help 2>&1 | grep -qF -- '--mine [--kind=vm]'; }

PLUME=""
# A Plume tab sets PLUME_CLI to its own app's tool, which may predate VMs and would read vm:<n>
# as an Android serial.
resolve_plume() {
  [[ -z "$PLUME" ]] || return 0
  local candidate
  if [[ -n "${PLUME_CLI:-}" ]]; then
    if supports_vms "$PLUME_CLI"; then
      PLUME="$PLUME_CLI"
      return 0
    fi
    log "skipping PLUME_CLI ($PLUME_CLI): it doesn't support VMs"
  fi
  candidate="$(products_dir 2>/dev/null)/Plume.app/Contents/Helpers/plume" || true
  if supports_vms "$candidate"; then
    PLUME="$candidate"
  elif candidate="$(type -P plume)" && supports_vms "$candidate"; then
    PLUME="$candidate"
  else
    die "no plume tool supports VMs: build this worktree (xcodebuild -scheme Plume build), or set PLUME_CLI"
  fi
}

plume() { resolve_plume; "$PLUME" "$@"; }

json_get() { printf '%s' "$CLAIM" | plutil -extract "$1" raw -o - - 2>/dev/null || true; }

# Leases (or renews) the caller's VM, sharing this checkout, and loads its fields.
claim_vm() {
  CLAIM="$(plume devices claim --kind=vm --json --worktree="$ROOT")"
  VM_KEY="$(json_get key)"
  [[ -n "$VM_KEY" ]] || die "claim returned no VM key: $CLAIM"
  SLOT="${VM_KEY#vm:}"
  VM_IP="$(json_get ip)"
  VM_USER="$(json_get user)"
  VM_SSH_KEY="$(json_get sshKey)"
  SHARE="$(json_get share)"
  GUEST_SHARE="$(json_get guestShare)"
  WORKTREE="$(json_get worktree)"
  GUEST_WORKTREE="$(json_get guestWorktree)"
  CONTROL_SOCKET="$(json_get controlSocket)"
  SLOT_DIR="$VMS_DIR/vm$SLOT"
  mkdir -p "$SLOT_DIR"
}

SSH_OPTS=(-o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5 -o ServerAliveInterval=30)
guest() { ssh -i "$VM_SSH_KEY" "${SSH_OPTS[@]}" "$VM_USER@$VM_IP" "$@"; }

# Kills the slot's tunnel and forgets its pid files. app.pid names a guest process, which dies with the VM.
stop_slot() {
  local dir="$VMS_DIR/vm${1:?}" pid=""
  if [[ -f "$dir/tunnel.pid" ]]; then
    pid="$(<"$dir/tunnel.pid")"
    if [[ -n "$pid" ]] && ps -p "$pid" -o command= 2>/dev/null | grep -q '^ssh ' \
      && ps -p "$pid" -o command= 2>/dev/null | grep -qF -- " -L $dir/control.sock:"; then
      kill "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "${dir:?}/tunnel.pid" "${dir:?}/app.pid"
}

# Guest bash that removes the links prepare made. Leaves $list set to the list file.
GUEST_UNLINK='list="$HOME/.plume-vm-links"
if [[ -f "$list" ]]; then
  while IFS= read -r link; do
    if [[ -L "$link" ]]; then sudo rm -f "$link"; fi
  done < "$list"
fi
'

cmd_prepare() {
  log "Mirroring host paths in $VM_KEY"
  local script
  script='set -euo pipefail
'"$GUEST_UNLINK"': > "$list"
rm -rf "$HOME/PlumeVM"
while [[ $# -ge 2 ]]; do
  target="$1"; link="$2"; shift 2
  [[ -e "$link" && ! -L "$link" ]] && { echo "$link exists in the guest and is not a symlink" >&2; exit 1; }
  sudo mkdir -p "$(dirname "$link")"
  sudo ln -sfn "$target" "$link"
  printf "%s\n" "$link" >> "$list"
done'
  guest "bash -s -- $(q "$GUEST_WORKTREE") $(q "$WORKTREE") $(q "$GUEST_SHARE") $(q "$SHARE")" <<<"$script"
}

bundle_id() { plutil -extract CFBundleIdentifier raw -o - "$1/Contents/Info.plist"; }

# The guest's Full Disk Access answer for a bundle ID: 2 granted, 0 denied, empty when never asked.
# Fails when the TCC database is unreadable; the Cirrus image grants sshd Full Disk Access.
guest_fda() {
  guest "sqlite3 '/Library/Application Support/com.apple.TCC/TCC.db' \"select max(auth_value) from access where service='kTCCServiceSystemPolicyAllFiles' and client='$1' and client_type=0\""
}

# Reads --app PATH or --app=PATH from the front of the arguments into APP_ARG, and the count
# it used into ARGS_USED.
app_arg() {
  case "$1" in
    --app) [[ $# -ge 2 ]] || die "--app needs a path"; APP_ARG=$2; ARGS_USED=2 ;;
    --app=*) APP_ARG="${1#--app=}"; ARGS_USED=1 ;;
  esac
}

# Prints the app to install: the given path, else this worktree's debug build.
resolve_app() {
  local app=${1:-}
  [[ -n "$app" ]] || app="$(products_dir)/Plume.app"
  [[ -d "$app" ]] || die "no app at $app: build this worktree first, or pass --app"
  printf '%s\n' "$app"
}

wait_for_guest_socket() {
  for _ in $(seq 1 30); do
    guest 'test -S /tmp/plume-control.sock' 2>/dev/null && return 0
    sleep 2
  done
  return 1
}

cmd_launch() {
  local app="" seed="" envs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --app|--app=*) app_arg "$@"; app=$APP_ARG; shift "$ARGS_USED" ;;
      --seed) seed="$2"; shift 2 ;;
      --seed=*) seed="${1#--seed=}"; shift ;;
      --env) envs+=("$2"); shift 2 ;;
      --env=*) envs+=("${1#--env=}"); shift ;;
      *) die "unknown launch argument: $1" ;;
    esac
  done
  app="$(resolve_app "$app")"

  claim_vm
  launch_app "$app" "$seed" ${envs[@]+"${envs[@]}"}

  local id fda
  id="$(bundle_id "$app")"
  if ! fda="$(guest_fda "$id" 2>/dev/null)"; then
    log "couldn't read $VM_KEY's TCC database, so Full Disk Access is unknown"
  elif [[ "$fda" != 2 ]]; then
    echo "plume-vm: $id has no Full Disk Access in $VM_KEY, so it shows the \"Grant Full Disk Access?\" sheet on first launch; grant it once per base image with scripts/vm/plume-vm grant-fda" >&2
  fi

  local branch
  branch="$(git -C "$ROOT" branch --show-current)"
  plume devices installed "$VM_KEY" "$branch" >/dev/null

  cat <<MSG
$VM_KEY is running $(basename "$app") on $branch. Drive it with:
  scripts/debug/plume-control.py --socket "$CONTROL_SOCKET" hierarchy
Right after launch, menu chords read disabled until a tab chip is invoked. Run this once before sending chords:
  scripts/debug/plume-control.py --socket "$CONTROL_SOCKET" invoke target='{"id":"tab-chip","index":0}'
MSG
}

# Copies the app into the claimed VM, starts it, and forwards its control socket. --no-mirror
# skips prepare, whose links and parent directories would otherwise stay in the guest.
launch_app() {
  local mirror=1
  if [[ "$1" == --no-mirror ]]; then mirror=0; shift; fi
  local app=$1 seed=$2 envs=("${@:3}")
  stop_slot "$SLOT"
  guest 'pkill -x Plume || true'
  [[ $mirror -eq 0 ]] || cmd_prepare

  # A fresh folder name each time: the guest's virtiofs can keep listing a recreated folder as empty.
  local drop
  drop="app-$(date +%s)"
  log "Copying $(basename "$app") into the share"
  rm -rf "${SHARE:?}"/app "${SHARE:?}"/app-*
  mkdir -p "$SHARE/$drop"
  cp -Rc "$app" "$SHARE/$drop/Plume.app"

  # rsync, not ditto or cp: virtiofs breaks bundle symlinks for both.
  log "Installing it in the guest"
  guest "mkdir -p \"\$HOME/PlumeVM\" && rsync -a --delete $(q "$GUEST_SHARE/$drop/Plume.app/") \"\$HOME/PlumeVM/Plume.app/\""

  local open_envs=" --env PLUME_CONTROL_SOCKET=/tmp/plume-control.sock" e
  [[ -z "$seed" ]] || open_envs+=" --env $(q "PLUME_SEED_TASKS=$seed")"
  for e in ${envs[@]+"${envs[@]}"}; do open_envs+=" --env $(q "$e")"; done
  log "Launching"
  guest "rm -f /tmp/plume-control.sock; open$open_envs \"\$HOME/PlumeVM/Plume.app\""
  wait_for_guest_socket || die "the guest app's control socket never appeared"
  guest 'pgrep -x Plume | head -1' > "$SLOT_DIR/app.pid" || true

  log "Forwarding the control socket"
  mkdir -p "$(dirname "$CONTROL_SOCKET")"
  local forward="$CONTROL_SOCKET:/tmp/plume-control.sock" pattern
  ssh -f -N -i "$VM_SSH_KEY" "${SSH_OPTS[@]}" -o ExitOnForwardFailure=yes -o StreamLocalBindUnlink=yes \
    -L "$forward" "$VM_USER@$VM_IP"
  pattern="$(printf '%s' "-L $forward" | sed 's/[][\.*^$+?(){}|]/\\&/g')"
  pgrep -f -- "$pattern" | head -1 > "$SLOT_DIR/tunnel.pid" || true

  python3 "$CONTROL" --socket "$CONTROL_SOCKET" --wait 30 tasks >/dev/null \
    || die "the control socket forward doesn't answer"
}

# Reads `xcresulttool get test-results tests` JSON on stdin and fails, naming each one, if any
# -only-testing identifier (target[/suite...[/test]]) matches no test that ran. Each component
# must match in full, and a test's trailing "()" is optional.
UNMATCHED_FILTERS='
import json, sys
try:
    nodes = json.load(sys.stdin).get("testNodes", [])
except ValueError:
    nodes = []
ran = []
def walk(node, path):
    kind = node.get("nodeType", "")
    if kind.endswith("test bundle") or kind == "Test Suite":
        path = path + [node.get("name", "")]
    elif kind == "Test Case":
        if node.get("result") != "Skipped":
            ran.append(path + [node.get("name", "")])
        return
    for child in node.get("children", []):
        walk(child, path)
for node in nodes:
    walk(node, [])
def same(a, b):
    return a.removesuffix("()") == b.removesuffix("()")
unmatched = [f for f in sys.argv[1:]
             if not any(len(f.split("/")) <= len(p) and all(same(x, y) for x, y in zip(f.split("/"), p)) for p in ran)]
for f in unmatched:
    print("plume-vm: no tests from %s ran" % f, file=sys.stderr)
sys.exit(1 if unmatched else 0)
'

cmd_test() {
  local only=() skip_build=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --only-testing) only+=("$2"); shift 2 ;;
      --only-testing=*) only+=("${1#--only-testing=}"); shift ;;
      --skip-build) skip_build=1; shift ;;
      *) die "unknown test argument: $1" ;;
    esac
  done
  [[ ${#only[@]} -gt 0 ]] || only=("${DEFAULT_TESTS[@]}")

  claim_vm
  guest 'test -d /Applications/Xcode.app' || die "this VM's base image has no Xcode, so it can't run tests; rebuild it with scripts/vm/make-base-image.sh --with-xcode --force, then run plume devices reset $VM_KEY once it is released"
  local host_xcode guest_xcode
  host_xcode="$(xcodebuild -version | paste -sd' ' -)"
  guest_xcode="$(guest 'xcodebuild -version' | paste -sd' ' -)"
  [[ "$host_xcode" == "$guest_xcode" ]] \
    || die "guest Xcode ($guest_xcode) differs from the host's ($host_xcode); rebuild the base image with make-base-image.sh, then run plume devices reset $VM_KEY once it is released"

  stop_slot "$SLOT"
  guest 'pkill -x Plume || true'

  if [[ $skip_build -eq 0 ]]; then
    log "Building for testing"
    (cd "$ROOT" && xcodebuild -scheme Plume -destination 'platform=macOS' -derivedDataPath "$DERIVED_DATA" build-for-testing)
  fi
  [[ -d "$DERIVED_DATA/Build/Products" ]] || die "no build products in $DERIVED_DATA; run without --skip-build"

  cmd_prepare
  log "Copying the products into the share"
  rm -rf "${SHARE:?}/products"
  cp -Rc "$DERIVED_DATA/Build/Products" "$SHARE/products"
  guest "mkdir -p \"\$HOME/PlumeVM\" && rsync -a --delete $(q "$GUEST_SHARE/products/") \"\$HOME/PlumeVM/Products/\""

  local stamp only_args="" t status=0
  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$SHARE/results"
  for t in "${only[@]}"; do only_args+=" -only-testing:$(q "$t")"; done
  log "Running ${only[*]} in $VM_KEY"
  guest "xctestrun=\$(ls \"\$HOME\"/PlumeVM/Products/*.xctestrun | head -1) && xcodebuild test-without-building -xctestrun \"\$xctestrun\" -destination 'platform=macOS'$only_args -resultBundlePath $(q "$GUEST_SHARE/results/$stamp.xcresult")" || status=$?

  local result="$SHARE/results/$stamp.xcresult"
  echo "xcresult: $result"
  if [[ -d "$result" ]]; then
    xcrun xcresulttool get test-results summary --path "$result" --compact || true
    xcrun xcresulttool get test-results tests --path "$result" --compact 2>/dev/null \
      | python3 -c "$UNMATCHED_FILTERS" "${only[@]}" || status=1
  else
    echo "plume-vm: no result bundle was written" >&2
    status=1
  fi
  return "$status"
}

# Full Disk Access is a TCC grant: SIP protects TCC.db and only MDM can push one, so a person
# grants it once, in a VM tab, and that clone becomes the base every later clone inherits.
cmd_grant_fda() {
  local app=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --app|--app=*) app_arg "$@"; app=$APP_ARG; shift "$ARGS_USED" ;;
      *) die "unknown grant-fda argument: $1" ;;
    esac
  done
  app="$(resolve_app "$app")"
  local id os base fda i
  id="$(bundle_id "$app")"
  os="$(sw_vers -productVersion | cut -d. -f1)"
  base="plume-base-$os"
  recover_base "$os" "$base"
  tart get "$base" >/dev/null 2>&1 || die "no $base; build it with scripts/vm/make-base-image.sh"

  # The claimed clone becomes the base, so it must be a fresh clone of the current one.
  delete_stale_clones "$os"
  local before
  before="$(tart list --source local -q)"
  claim_vm
  GRANT_VM_KEY=$VM_KEY
  trap release_grant_vm EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  local clone="plume-$os-$SLOT"
  if grep -qxF "$clone" <<<"$before"; then
    die "$clone was in use, so it may predate $base or hold earlier test runs; once it stops, run scripts/vm/plume-vm reset $VM_KEY, then grant-fda again"
  fi

  fda="$(guest_fda "$id")" || die "can't read $VM_KEY's TCC database over ssh"
  if [[ "$fda" == 2 ]]; then
    log "$base already grants $id Full Disk Access; nothing to save"
    release_grant_vm || die "couldn't release $VM_KEY"
    record_fda "$os" "$id"
    return 0
  fi

  local created
  created="$(guest_absent_paths)" || die "can't list $VM_KEY's home over ssh"
  launch_app --no-mirror "$app" ""
  guest "open 'x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles'"
  cat >&2 <<MSG

In Plume, open a device tab and click Show on $VM_KEY under macOS VMs. Then, in the guest's
System Settings ▸ Privacy & Security ▸ Full Disk Access:
  1. Turn on Plume α, the debug build. If it isn't listed, click +, press ⌘⇧G, enter ~/PlumeVM/Plume.app, and click Open.
  2. When asked for a password, enter: admin
  3. If asked to quit and reopen it, click Later.
Waiting up to 15 minutes for the grant...
MSG
  for i in $(seq 1 300); do
    [[ "$(guest_fda "$id" 2>/dev/null)" == 2 ]] && break
    [[ $i -lt 300 ]] || die "no grant after 15 minutes; run grant-fda again"
    sleep 3
  done
  log "Granted"

  log "Checking the sheet stays away after a fresh launch"
  quit_guest_app
  guest "defaults delete $(q "$id") hasPromptedForFullDiskAccess 2>/dev/null || true"
  launch_app --no-mirror "$app" ""
  check_no_fda_sheet "$app"
  log "The app holds Full Disk Access"

  log "Cleaning up $VM_KEY"
  quit_guest_app
  # shellcheck disable=SC2086 # $created is one guest-quoted word per path
  guest "bash -s -- $(q "$id") $created" <<<"$GUEST_UNLINK"'
id=$1; shift
pkill -x "System Settings"
rm -f "$list"
defaults delete "$id" 2>/dev/null
rm -rf "$HOME/PlumeVM" "$HOME/Library/Application Support"/Plume.debug* \
  "$HOME/Library/Caches/$id" "$HOME/Library/HTTPStorages/$id" "$HOME/Library/WebKit/$id" \
  "$HOME/Library/Saved Application State/$id.savedState" /tmp/plume-control.sock
for path in "$@"; do rm -rf "${HOME:?}/$path"; done
true'
  release_grant_vm || die "couldn't release $VM_KEY"

  log "Waiting for $VM_KEY to stop"
  for i in $(seq 1 60); do
    with_locks 1 "$VMS_DIR/$clone.lock" true && break
    [[ $i -lt 60 ]] || die "$clone is still locked; once it stops, run grant-fda again"
    sleep 2
  done

  # Every slot's lock is held across the swap, so no Plume clones a half-replaced base.
  log "Saving $clone as $base"
  local status=0
  with_slot_locks "$os" bash -c "$SWAP_BASE" _ "$clone" "$base" || status=$?
  case $status in
    0) ;;
    3) die "another VM is running; release every VM, then run grant-fda again" ;;
    *) die "saving $clone as $base failed" ;;
  esac
  record_fda "$os" "$id"
  delete_stale_clones "$os"
  log "$base now grants $id Full Disk Access; every new clone inherits it"
}

# Paths under the guest's home the app may create, printed guest-quoted when absent, so cleanup
# removes only what this run made.
guest_absent_paths() {
  guest 'bash -s' <<'EOF'
cd "$HOME" || exit 1
for p in .claude .claude/skills "Library/Application Support/Plume"; do
  [[ -e "$p" ]] || printf '%q ' "$p"
done
EOF
}

# Settles before the caller touches the app's defaults, which a quitting app may still write.
quit_guest_app() {
  guest 'pkill -x Plume; for _ in $(seq 1 20); do pgrep -x Plume >/dev/null || exit 0; sleep 0.5; done; exit 1' \
    || die "the guest app didn't quit"
}

GRANT_VM_KEY=""
# Releases grant-fda's VM and drops its tunnel, once; also the EXIT trap for an early exit.
release_grant_vm() {
  [[ -n "$GRANT_VM_KEY" ]] || return 0
  local key=$GRANT_VM_KEY status=0
  GRANT_VM_KEY=""
  plume devices release "$key" >/dev/null || status=$?
  stop_slot "${key#vm:}"
  return "$status"
}

# Waits for the main window, then for the sheet, which the window's .task presents a beat later.
check_no_fda_sheet() {
  local i count
  for i in $(seq 1 30); do
    count="$(control_count sidebar-archive-button 2>/dev/null)" && [[ "$count" -gt 0 ]] && break
    [[ $i -lt 30 ]] || die "the guest app's main window never appeared"
    sleep 1
  done
  for i in $(seq 1 10); do
    count="$(control_count full-disk-access-dismiss-button)" || die "couldn't read the guest app's controls"
    [[ "$count" -eq 0 ]] \
      || die "the app still shows its Full Disk Access sheet, so the grant doesn't match this build's signature; check codesign -d -r- on $1"
    sleep 1
  done
}

control_count() {
  python3 "$CONTROL" --socket "$CONTROL_SOCKET" list plumeID="$1" \
    | python3 -c 'import json, sys; print(len(json.load(sys.stdin)["result"]))'
}

record_fda() {
  plutil -replace fullDiskAccess -string "$2" "$VMS_DIR/base-$1.json" \
    || echo "warning: couldn't record the grant in $VMS_DIR/base-$1.json" >&2
}

# Restores the base from an interrupted swap, which leaves only $base-old.
recover_base() {
  local os=$1 base=$2
  tart get "$base" >/dev/null 2>&1 && return 0
  tart get "$base-old" >/dev/null 2>&1 || return 0
  log "Restoring $base from $base-old, left by an interrupted grant-fda"
  with_slot_locks "$os" tart rename "$base-old" "$base" \
    || die "couldn't restore $base; once every VM is released, run: tart rename $base-old $base"
}

# Args: clone base. The old base stays as $base-old until the new one is in place.
# shellcheck disable=SC2016
SWAP_BASE='clone=$1 base=$2
tart delete "$base-fda" >/dev/null 2>&1
tart delete "$base-old" >/dev/null 2>&1
tart clone "$clone" "$base-fda" || exit 1
if ! tart rename "$base" "$base-old"; then
  tart delete "$base-fda"
  exit 1
fi
if ! tart rename "$base-fda" "$base"; then
  tart rename "$base-old" "$base" || echo "plume-vm: $base is missing; restore it with: tart rename $base-old $base" >&2
  exit 1
fi
tart delete "$base-old" || echo "warning: could not delete $base-old; delete it with: tart delete $base-old" >&2
exit 0'

cmd="${1:-help}"
[[ $# -eq 0 ]] || shift
case "$cmd" in
  -h|--help|help) usage ;;
  claim)
    [[ " $* " == *" --worktree"* ]] || set -- --worktree="$ROOT" "$@"
    plume devices claim --kind=vm "$@"
    ;;
  list) plume devices list --kind=vm "$@" ;;
  reset) plume devices reset "$@" ;;
  release)
    if [[ "${1:-}" == vm:* ]]; then
      plume devices release "$@"
      stop_slot "${1#vm:}"
    else
      out="$(plume devices release --mine --kind=vm "$@")"
      echo "$out"
      for key in $(grep -oE 'vm:[0-9]+' <<<"$out"); do stop_slot "${key#vm:}"; done
    fi
    ;;
  ssh)
    claim_vm
    [[ "${1:-}" != -- ]] || shift
    guest "$@"
    ;;
  prepare) claim_vm; cmd_prepare ;;
  launch) cmd_launch "$@" ;;
  test) cmd_test "$@" ;;
  grant-fda) cmd_grant_fda "$@" ;;
  *) usage >&2; exit 2 ;;
esac
